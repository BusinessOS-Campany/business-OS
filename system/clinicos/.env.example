# --- Database (PostgreSQL) ---
# Local development:
DATABASE_URL="postgresql://postgres:<password>@localhost:5432/clinicos?schema=public"
#
# Production (Supabase) — use the TRANSACTION pooler (port 6543) for serverless:
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
# For migrations / long jobs use the SESSION pooler (port 5432):
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# --- Better Auth ---
# Generate with: npx auth secret (or openssl rand -base64 32)
BETTER_AUTH_SECRET="replace-with-a-long-random-secret-at-least-32-chars"
# Local:
BETTER_AUTH_URL="http://localhost:3000"
# Production: set to your Vercel URL, e.g. https://your-app.vercel.app

# --- Mount point (where this app is served) ---
# Standalone this is `/clinicos`. The platform's supervisor overrides it with the
# org mount (`/{org}/clinicos`) when it runs an organization's own copy, and
# `next.config.ts` falls back to this value if it is unset. If the app's client
# half and the build's basePath disagree, sign-in posts to the wrong path and the
# installed PWA is scoped to "/" instead of the app.
NEXT_PUBLIC_BASE_PATH="/clinicos"

# --- Storage (private uploads - never served statically) ---
# Local:
DOCUMENT_STORAGE_DIR="./storage/patient-documents"
# Vercel: the filesystem is read-only except /tmp (ephemeral, NOT persistent).
# For durable uploads use object storage (e.g. Supabase Storage) instead.
# DOCUMENT_STORAGE_DIR="/tmp/patient-documents"

# --- Seed (development/demo only) ---
# SEED_ADMIN_EMAIL="admin@clinic.local"
# SEED_ADMIN_PASSWORD="ChangeMe!123"
# SEED_ADMIN_USERNAME="admin"

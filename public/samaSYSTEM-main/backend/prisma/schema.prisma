generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  SUPERVISOR
  RECEPTIONIST
  THERAPIST
  PATIENT
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  email     String   @unique
  password  String
  firstName String
  lastName  String
  phone     String?
  role      Role     @default(RECEPTIONIST)
  isActive  Boolean  @default(true)
  department String?
  permissions String[] @default([])
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  conversations  ConversationParticipant[]
  sentMessages   Message[]

  @@map("users")
}

model Conversation {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  participants ConversationParticipant[]
  messages     Message[]

  @@map("conversations")
}

model ConversationParticipant {
  id             String       @id @default(uuid())
  conversationId String       @map("conversation_id")
  userId         String       @map("user_id")
  joinedAt       DateTime     @default(now()) @map("joined_at")
  archivedAt     DateTime?    @map("archived_at")

  conversation  Conversation @relation(fields: [conversationId], references: [id])
  user          User         @relation(fields: [userId], references: [id])

  @@unique([conversationId, userId])
  @@map("conversation_participants")
}

model Message {
  id             String    @id @default(uuid())
  conversationId String    @map("conversation_id")
  senderId       String    @map("sender_id")
  content        String
  attachment     String?   @map("attachment")
  attachmentName String?   @map("attachment_name")
  attachmentSize Int?      @map("attachment_size")
  contentType    String?   @map("content_type")
  readAt         DateTime? @map("read_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  conversation Conversation @relation(fields: [conversationId], references: [id])
  sender       User         @relation(fields: [senderId], references: [id])

  @@map("messages")
}

model Patient {
  id               String    @id @default(uuid())
  serialNumber     Int       @default(0) @map("serial_number")
  manualId         String?   @map("manual_id")
  firstName        String?   @map("first_name")
  lastName         String?   @map("last_name")
  phone            String?
  gender           String?
  dateOfBirth      DateTime? @map("date_of_birth")
  examType         String?   @map("exam_type")
  price            Float?
  paymentMethod    String?   @map("payment_method")
  walletType       String?   @map("wallet_type")
  transactionNumber String?  @map("transaction_number")
  installments     String?
  registrationDate DateTime? @map("registration_date")
  notes            String?
  speacial         String?
  status           String?   @default("progress")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")

  @@map("patients")
}

model Service {
  id        String    @id @default(uuid())
  name      String    @unique @map("name")
  nameEn    String?   @map("name_en")
  price     Float     @map("price")
  iconUrl   String?   @map("icon_url")
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("services")
}

model Employee {
  id         String    @id @default(uuid())
  name       String    @map("name")
  department String?   @map("department")
  phone      String?
  salary     Float?
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")

  @@map("employees")
}

model Appointment {
  id        String    @id @default(uuid())
  patient   String    @map("patient")
  phone     String?   @map("phone")
  therapist String?   @map("therapist")
  date      String?   @map("date")
  status    String?   @default("pending")
  notes     String?
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("appointments")
}

model Session {
  id          String    @id @default(uuid())
  fullname    String    @map("fullname")
  sessionType String    @map("session_type")
  speacial    String?   @map("speacial")
  status      String?   @default("progress")
  sessionDate DateTime? @map("session_date")
  price       Float?
  notes            String?
  subscriptionPeriod String?  @map("subscription_period")
  subscriptionAmount Float?   @map("subscription_amount")
  subscriptionDay   Int?      @map("subscription_day")
  subscriptionAttendance String? @map("subscription_attendance")
  installments   String?   @map("installments")
  paymentMethod  String?   @map("payment_method")
  walletType     String?   @map("wallet_type")
  transactionNumber String? @map("transaction_number")
  prepaid        Boolean?  @default(false)
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")

  @@map("sessions")
}

model SalaryAdvance {
  id        String    @id @default(uuid())
  employee  String    @map("employee")
  specialty String?   @map("specialty")
  amount    Float     @map("amount")
  date      String    @map("advance_date")
  notes     String?
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("salary_advances")
}

model Expense {
  id            String    @id @default(uuid())
  category      String    @map("category")
  amount        Float     @map("amount")
  date          String    @map("date")
  paymentMethod String?   @map("payment_method")
  employee      String?   @map("employee")
  notes         String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  @@map("expenses")
}

model Notification {
  id        String    @id @default(uuid())
  type      String
  data      String?
  createdAt DateTime  @default(now()) @map("created_at")
  readAt    DateTime? @map("read_at")

  @@map("notifications")
}

model CalendarEvent {
  id          String    @id @default(uuid())
  eventName   String    @map("event_name")
  date        String    @map("date")
  endDate     String?   @map("end_date")
  type        String    @map("type")
  startTime   String?   @map("start_time")
  endTime     String?   @map("end_time")
  location    String?
  description String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  @@map("calendar_events")
}

model Coverage {
  id             String    @id @default(uuid())
  name           String    @map("name")
  sessionType    String    @default("normal") @map("session_type")
  date           String    @map("date")
  price          Float     @map("price")
  therapistShare Float?    @default(500) @map("therapist_share")
  from           String?   @map("from")
  to             String?   @map("to")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  @@map("coverages")
}

model Invoice {
  id        String    @id @default(uuid())
  type      String    @default("electricity") @map("type")
  date      String    @map("date")
  amount    Float     @map("amount")
  notes     String?
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("invoices")
}

model Package {
  id        String    @id @default(uuid())
  name      String    @map("name")
  priceUsd  Float     @map("price_usd")
  priceYer  Float     @map("price_yer")
  features  String[]  @default([])
  popular   Boolean   @default(false)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("packages")
}

model Testimonial {
  id          String   @id @default(dbgenerated("gen_random_uuid()"))
  patientName String   @map("patient_name")
  rating      Int      @default(5)
  textEn      String   @map("text_en")
  textAr      String?  @map("text_ar")
  treatment   String?  @map("treatment")
  photoUrl    String?  @map("photo_url")
  isFeatured  Boolean  @default(false) @map("is_featured")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("testimonials")
}

model Doctor {
  id              String   @id @default(dbgenerated("gen_random_uuid()"))
  slug            String
  name            String
  nameAr          String?  @map("name_ar")
  specialty       String
  specialtyAr     String?  @map("specialty_ar")
  bio             String?
  photoUrl        String?  @map("photo_url")
  experienceYears Int      @default(0) @map("experience_years")
  rating          Decimal  @default(5) @db.Decimal(3, 2)
  isActive        Boolean  @default(true) @map("is_active")
  sortOrder       Int      @default(0) @map("sort_order")
  createdAt       DateTime @default(now()) @map("created_at")

  @@map("doctors")
}

model BlogPost {
  id          String    @id @default(dbgenerated("gen_random_uuid()"))
  slug        String
  titleEn     String    @map("title_en")
  titleAr     String?   @map("title_ar")
  excerptEn   String?   @map("excerpt_en")
  excerptAr   String?   @map("excerpt_ar")
  contentEn   String?   @map("content_en")
  contentAr   String?   @map("content_ar")
  coverUrl    String?   @map("cover_url")
  authorId    String?   @map("author_id")
  category    String?
  tags        String[]  @default([])
  isPublished Boolean   @default(false) @map("is_published")
  publishedAt DateTime? @map("published_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@map("blog_posts")
}

model ContactMessage {
  id         String   @id @default(dbgenerated("gen_random_uuid()"))
  name       String
  email      String
  phone      String?
  subject    String?
  message    String
  isResolved Boolean  @default(false) @map("is_resolved")
  reply      String?  @map("reply")
  repliedAt  DateTime? @map("replied_at")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("contact_messages")
}

model NewsletterSubscriber {
  id        String   @id @default(dbgenerated("gen_random_uuid()"))
  email     String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("newsletter_subscribers")
}

model InsuranceCompany {
  id          String    @id @default(uuid())
  name        String    @map("name")
  logoUrl     String?   @map("logo_url")
  description String?
  sortOrder   Int       @default(0) @map("sort_order")
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  @@map("insurance_companies")
}

model GalleryImage {
  id          String    @id @default(dbgenerated("gen_random_uuid()"))
  url         String
  titleEn     String    @map("title_en")
  titleAr     String?   @map("title_ar")
  categoryEn  String?   @map("category_en")
  categoryAr  String?   @map("category_ar")
  description String?
  ratio       String    @default("aspect-[4/3]")
  sortOrder   Int       @default(0) @map("sort_order")
  createdAt   DateTime  @default(now()) @map("created_at")
  deletedAt   DateTime? @map("deleted_at")

  @@map("gallery_images")
}
